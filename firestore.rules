rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "jornaabdullah@gmail.com";
    }
    match /tournaments/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /registrations/{id} {
      allow create: if
        request.resource.data.keys().hasAll(['name','uid','contact','tournamentId','tournamentName','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.uid is string
        && request.resource.data.contact is string
        && request.resource.data.tournamentId is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.uid.size() > 0
        && request.resource.data.uid.size() <= 20
        && request.resource.data.contact.size() <= 20;
      allow read, update, delete: if isAdmin();
    }
    match /tournament_private/{id} {
      allow read, write: if isAdmin();
    }
  }
}